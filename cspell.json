{
    "version": "0.2",
    "language": "en",
    "ignorePaths": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.vscode/**",
        "**/.cspell/**",
        "**/logs/**",
        "**/tmp/**",
        "**/temp/**"
    ],
    "files": [
        "**/*.md",
        "**/*.txt",
        "_data/**/*.json",
        "**/*.yml",
        "**/*.yaml",
        "**/LICENSE"
    ],
    "words": [
        "albertbanke",
        "codeowners",
        "devcontainer",
        "devcontainers",
        "devx",
        "lakruzz",
        "ravvnen",
        "responsibles",
        "SMED",
        "squezeed",
        "takt",
        "thetechcollective",
        "workon",
        "wrapup"
    ],
    "ignoreWords": [
        "cspell",
        "ffmerge",
        "cspellrc",
        "pytest",
        "coveragerc",
        "pyproject"
    ],
  "dictionaryDefinitions": [
    {
      "name": "Repo dictionary",
      "path": "./.dict/repo.txt",
    },
  ],
  "dictionaries": ["Repo dictionary"],
  "ignoreRegExpList": [
    "{%[\\s\\S]*?%}", // ignore inline liquid tags
    "^---[\\s\\S]*?^---$", // ignore YAML front matter
    "^```[\\s\\S]*?^```$", // ignore code block
    "{%\\shighlight[\\s\\S]*?{%\\sendhighlight\\s%}", // ignore highlight liquid tag blocks
    "`.*`", // ignore inline code
    "<code>.*</code>", // ignore HTML code tags
    "<!--.*?-->", // ignore HTML comments
    "<a.*?>", // ignore HTML anchor tags,
    "<img.*?>", // ignore HTML image tags,
    "'.*'", // ignore text in single quotes
  ]
}
